# ── Base de datos (Supabase o Neon) ─────────────────────────────
# Conexión con pooler (la usa la app en runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Conexión directa (la usa Prisma para migraciones)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth.js ────────────────────────────────────────────────────
# Genera uno con: pnpm dlx auth secret
AUTH_SECRET=""
# Google OAuth: https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada: https://TU-DOMINIO/api/auth/callback/google (y http://localhost:3000/... en local)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Enlace mágico por email vía Resend: https://resend.com
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Club de la Pichanga <no-responder@tudominio.cl>"

# Correos que siempre son admin al entrar (separados por coma)
ADMIN_EMAILS=""

# ── Correos salientes (código para confirmar el correo al registrarse) ──
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords. Sin esto, en local el código sale en la consola.
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
# Opcionales (por defecto smtp.gmail.com:465 y remitente "Club de la Pichanga <EMAIL_SERVER_USER>")
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_FROM=""

# ── Supabase Storage (fotos de perfil) ── Supabase → Project Settings → API. La service role key es secreta: solo en Vercel/.env
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Opcional: correo de contacto que se muestra en /privacidad y /terminos
NEXT_PUBLIC_CONTACT_EMAIL=""
# Opcional: correo que el seed convierte en admin
SEED_ADMIN_EMAIL=""
